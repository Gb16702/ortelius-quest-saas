# Local/CI E2E environment only. Do not use with production data.
FRONTEND_URL=http://localhost:5175
CORS_ORIGINS=http://localhost:5175

# Docker Compose host ports
API_PORT=4100
POSTGRES_PORT=5110
REDIS_PORT_HOST=6380

# Runtime inside the e2e containers
PORT=4100
HOST=0.0.0.0
NODE_ENV=test
ENABLE_TEST_AUTH_BYPASS=true
ENABLE_METRICS=false
ENABLE_SWAGGER=true
ENABLE_RATE_LIMIT=false
LOG_LEVEL=info
LOG_FORMAT=json

# Database
DB_NAME=ortelius_e2e_db
DB_USER=ortelius_e2e
DB_PASSWORD=ortelius_e2e_password
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://ortelius_e2e:ortelius_e2e_password@postgres:5432/ortelius_e2e_db
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=30000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth / security
COGNITO_USERPOOL_ID=e2e-user-pool
COGNITO_CLIENT_ID=e2e-client
COGNITO_REGION=eu-west-3
AUTH_PORTAL_URL=http://localhost:5175
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
ADMIN_SERVICE_TOKEN=e2e-admin-service-token

# Stripe test placeholders
STRIPE_SECRET_KEY=sk_test_e2e_mock
STRIPE_PUBLISHABLE_KEY=pk_test_e2e_mock
STRIPE_WEBHOOK_SECRET=whsec_e2e_mock
STRIPE_PRICE_STARTER_MONTHLY=price_e2e_starter_monthly
STRIPE_PRICE_STARTER_ANNUAL=price_e2e_starter_annual
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_e2e_professional_monthly
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_e2e_professional_annual
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_e2e_enterprise_monthly
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_e2e_enterprise_annual

# External service placeholders
POSTMARK_API_KEY=postmark_e2e_mock
AWS_REGION=eu-west-3
AWS_S3_ACCESS_KEY_ID=aws_e2e_key
AWS_S3_SECRET_ACCESS_KEY=aws_e2e_secret
AWS_S3_BUCKET_NAME=ortelius-e2e-bucket
OPENAI_API_KEY=openai_e2e_mock
VIEW_TRACKING_SALT=e2e-view-tracking-salt

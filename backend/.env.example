FRONTEND_URL=http://localhost:5173

# Database Configuration
POSTGRES_DB=ortelius_db
POSTGRES_USER=ortelius
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://ortelius:your_encoded_password@localhost:5432/ortelius_db

# API Configuration
API_PORT=3000
PORT=3000
HOST=localhost
NODE_ENV=development
STUDIO_PORT=4983

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Auth Configuration (Better Auth)
BETTER_AUTH_SECRET=generate_a_secure_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
BASE_DOMAIN=ortelius.app

# Stripe Price IDs - Test Mode
STRIPE_PRICE_STARTER_MONTHLY=price_1SZsKLLqXMsEBXlWAiFu8WlA
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_1SZsOmLqXMsEBXlW65BFbuSf
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_1SZsQLLqXMsEBXlWiyGOd70G
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_1SZsS7LqXMsEBXlWJSOnvvo5
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_1SZsSZLqXMsEBXlWsH7P1akX


# Stripe Price IDs (Production - replace with live prices)
# STRIPE_PRICE_STARTER_MONTHLY=price_live_xxx
# STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_live_xxx
# STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_live_xxx
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_live_xxx
# STRIPE_PRICE_ENTERPRISE_ANNUAL=price_live_xxx

# Database Connection Settings
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=30000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Features
ENABLE_METRICS=false
ENABLE_SWAGGER=true
ENABLE_RATE_LIMIT=false
ENABLE_TEST_AUTH_BYPASS=false

# API Keys
# In production, use a secure key management system
API_KEY_PREFIX=ortelius_

# AWS Configuration
AWS_REGION=eu-west-1
AWS_S3_ACCESS_KEY_ID=your_access_key
AWS_S3_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET_NAME=your_bucket_name

VIEW_TRACKING_SALT=salt

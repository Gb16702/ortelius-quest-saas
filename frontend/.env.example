NODE_ENV=development

# Auth
APP_ORIGIN=http://localhost:5174
AUTH_URL=https://auth.preview.ortelius.app/
LOGIN_URL=https://ortelius.app/auth

# API (server-side, used at SSR / loaders)
API_URL=http://localhost:4000/

# API (client-side, exposed to the browser)
VITE_API_URL=http://localhost:4000/
VITE_WS_URL=ws://localhost:4000
VITE_PORTAL_ACCOUNT_URL=https://ortelius.app/account

# Analytics — Umami
VITE_UMAMI_URL=https://analytics.ortelius.app/script.js
VITE_UMAMI_WEBSITE_ID=

# Stripe — publishable key only (pk_test_… in dev, pk_live_… in prod)
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Maps — restricted by HTTP referrer in the GCP console
VITE_GMAPS_KEY=

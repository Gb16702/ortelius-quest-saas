{
  "name": "ortelius-quest-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "lodash": "4.18.1",
    "picomatch": "4.0.4",
    "qs": "6.15.1",
    "rollup": "4.60.3"
  },
  "scripts": {
    "build": "NODE_ENV=production bun --bun vite build",
    "dev": "bun --bun vite dev",
    "start": "NODE_ENV=production bun .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test src packages",
    "test:coverage": "bun test --coverage src packages",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check:boundaries": "bun scripts/check-import-boundaries.ts",
    "check:naming": "bun scripts/check-src-naming.ts",
    "check:msw-paths": "bun scripts/check-msw-handler-paths.ts",
    "check": "biome check . && bun run check:boundaries && bun run check:naming && bun run check:msw-paths",
    "check:fix": "biome check --write . && bun run check:boundaries && bun run check:naming && bun run check:msw-paths",
    "ci:check": "biome ci . && bun run check:boundaries && bun run check:naming && bun run check:msw-paths",
    "test:e2e": "playwright test",
    "dev:e2e": "bun --env-file=.env.e2e --bun vite dev --port 5175",
    "test:e2e:env": "bun --env-file=.env.e2e playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@dicebear/core": "^9.4.2",
    "@dicebear/initials": "^9.4.2",
    "@formisch/react": "^0.4.6",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@ortelius/websocket-types": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.170.4",
    "@tanstack/react-start": "^1.168.6",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-character-count": "^3.21.0",
    "@tiptap/extension-placeholder": "^3.21.0",
    "@tiptap/markdown": "^3.21.0",
    "@tiptap/react": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "@unpic/react": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^26.0.8",
    "input-otp": "^1.4.2",
    "isbot": "^5.1.27",
    "lucide-react": "^1.14.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "motion": "^12.38.0",
    "nuqs": "^2.6.0",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^17.0.4",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "use-stick-to-bottom": "^1.1.1",
    "valibot": "^1.4.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "1.168.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.13",
    "@types/google.maps": "^3.64.0",
    "@types/node": "^25",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "knip": "^6.12.0",
    "msw": "^2.14.6",
    "nitro": "npm:nitro-nightly@latest",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "8.0.12"
  }
}

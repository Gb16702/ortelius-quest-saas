{
  "name": "ortelius-organization-api",
  "version": "1.0.0",
  "description": "Modern REST API for Ortelius organization management built with Hono and Bun",
  "main": "src/index.ts",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "email:dev": "email dev --dir emails/templates",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx @biomejs/biome check src/",
    "lint:fix": "bunx @biomejs/biome check --write src/",
    "format": "bunx @biomejs/biome format --write src/",
    "type-check": "bunx tsc --noEmit --skipLibCheck",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:test-user": "bun run src/scripts/seed-test-user.ts",
    "seed:quest": "bun run src/scripts/seed-quest-organization.ts",
    "seed:e2e": "bun run src/scripts/seed-e2e-app.ts",
    "e2e:up": "docker compose --env-file .env.e2e -f docker-compose.e2e.yml -p ortelius-e2e up -d --build",
    "e2e:down": "docker compose --env-file .env.e2e -f docker-compose.e2e.yml -p ortelius-e2e down",
    "e2e:reset": "docker compose --env-file .env.e2e -f docker-compose.e2e.yml -p ortelius-e2e down -v",
    "e2e:schema": "docker exec ortelius-e2e-api bun run db:push",
    "e2e:seed": "docker exec ortelius-e2e-api bun run seed:e2e",
    "e2e:preflight": "bun run src/scripts/preflight-e2e.ts",
    "e2e:prepare": "bun run e2e:schema && bun run e2e:seed && bun run e2e:preflight"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1041.0",
    "@aws-sdk/client-rekognition": "^3.1035.0",
    "@aws-sdk/client-s3": "^3.1035.0",
    "@aws-sdk/lib-storage": "^3.1035.0",
    "@aws-sdk/s3-request-presigner": "^3.1035.0",
    "@esbuild/darwin-arm64": "^0.25.12",
    "@graphql-tools/schema": "^10.0.33",
    "@hono/zod-validator": "^0.7.6",
    "@ortelius/websocket-types": "workspace:*",
    "@react-email/components": "0.5.3",
    "@react-email/tailwind": "^2.0.7",
    "@resvg/resvg-js": "^2.6.2",
    "@scalar/hono-api-reference": "^0.9.48",
    "@tanstack/ai": "^0.28.0",
    "@tanstack/ai-openai": "^0.14.1",
    "@types/jspdf": "^2.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.14",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^10.0.0",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "file-type": "^22.0.1",
    "graphql": "^16.13.2",
    "graphql-yoga": "^5.21.0",
    "hono": "^4.12.14",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "jspdf": "^3.0.4",
    "openai": "^6.34.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.20.0",
    "postmark": "^4.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "stripe": "^22.1.0",
    "uuid": "^13.0.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@react-email/preview-server": "4.2.11",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "@types/postmark": "^2.0.3",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "react-email": "4.2.11"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "restore-cursor": "4.0.0"
  }
}
